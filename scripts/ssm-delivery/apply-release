#!/usr/bin/env bash
set -euo pipefail

readonly RELEASE_ROOT=/opt/threadia/releases
readonly ACTIVE_LINK=/opt/threadia/current
readonly RUNTIME_ENV=/etc/threadia/runtime.env
readonly SERVICE_NAME=threadia-backend.service

fail() {
  printf '%s\n' "release failed: $*" >&2
  exit 1
}

[[ "$(id -u)" -eq 0 ]] || fail "must run as root"
[[ "$#" -eq 5 ]] || fail "expected bucket, artifact key, version ID, SHA-256, and release ID"

bucket="$1"
artifact_key="$2"
version_id="$3"
expected_sha="$4"
release_id="$5"

[[ "$bucket" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ ]] || fail "invalid bucket"
[[ "$artifact_key" =~ ^releases/[0-9a-f]{40}/[0-9]+-[0-9]+/threadia-release-[0-9a-f]{40}-[0-9]+-[0-9]+\.tar\.gz$ ]] || fail "invalid artifact key"
[[ "$version_id" =~ ^[A-Za-z0-9._+=/-]{1,1000}[A-Za-z0-9._+=/-]{0,24}$ ]] || fail "invalid version ID"
[[ "$expected_sha" =~ ^[a-f0-9]{64}$ ]] || fail "invalid SHA-256"
[[ "$release_id" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ ]] || fail "invalid release ID"

for command in aws python3 sha256sum tar systemctl curl install uname; do
  command -v "$command" >/dev/null 2>&1 || fail "AMI prerequisite missing: $command"
done
[[ "$(uname -m)" == "x86_64" ]] || fail "bundled runtime supports Linux x86_64 only"

umask 027
stage="$(mktemp -d /opt/threadia/.release-stage.XXXXXX)"
cleanup() { rm -rf "$stage"; }
trap cleanup EXIT

archive="$stage/release.tar.gz"
aws s3api get-object --bucket "$bucket" --key "$artifact_key" --version-id "$version_id" "$archive" >/dev/null
[[ "$(sha256sum "$archive" | cut -d ' ' -f1)" == "$expected_sha" ]] || fail "artifact archive checksum mismatch"
tar -xzf "$archive" -C "$stage"
[[ -f "$stage/app.jar" && -f "$stage/manifest.json" && -f "$stage/app.jar.sha256" && -x "$stage/runtime/bin/java" ]] || fail "release layout is incomplete"
"$stage/runtime/bin/java" -version >/dev/null 2>&1 || fail "bundled runtime is incompatible with this host"

python3 - "$stage/manifest.json" "$release_id" <<'PY'
import json
import sys

manifest_path, release_id = sys.argv[1:]
with open(manifest_path, encoding="utf-8") as source:
    manifest = json.load(source)
if manifest != {"releaseId": release_id}:
    raise SystemExit("manifest does not match immutable command identity")
PY

jar_sha="$(sha256sum "$stage/app.jar" | cut -d ' ' -f1)"
[[ "$(tr -d '[:space:]' < "$stage/app.jar.sha256")" == "$jar_sha" ]] || fail "JAR checksum mismatch"

new_env="$stage/runtime.env"
parameters_json="$stage/runtime-parameters.json"
aws ssm get-parameters --with-decryption --names \
  /threadia/restricted-nonprod/runtime/THREADIA_DB_URL \
  /threadia/restricted-nonprod/runtime/THREADIA_DB_USERNAME \
  /threadia/restricted-nonprod/runtime/THREADIA_DB_PASSWORD \
  /threadia/restricted-nonprod/runtime/THREADIA_JWT_SECRET \
  /threadia/restricted-nonprod/runtime/THREADIA_COOKIE_SECURE \
  /threadia/restricted-nonprod/runtime/THREADIA_CORS_ALLOWED_ORIGIN \
  --output json > "$parameters_json"
python3 - "$parameters_json" "$new_env" <<'PY'
import json
import sys

required = {
    "/threadia/restricted-nonprod/runtime/THREADIA_DB_URL": "THREADIA_DB_URL",
    "/threadia/restricted-nonprod/runtime/THREADIA_DB_USERNAME": "THREADIA_DB_USERNAME",
    "/threadia/restricted-nonprod/runtime/THREADIA_DB_PASSWORD": "THREADIA_DB_PASSWORD",
    "/threadia/restricted-nonprod/runtime/THREADIA_JWT_SECRET": "THREADIA_JWT_SECRET",
    "/threadia/restricted-nonprod/runtime/THREADIA_COOKIE_SECURE": "THREADIA_COOKIE_SECURE",
    "/threadia/restricted-nonprod/runtime/THREADIA_CORS_ALLOWED_ORIGIN": "THREADIA_CORS_ALLOWED_ORIGIN",
}
with open(sys.argv[1], encoding="utf-8") as source:
    response = json.load(source)
values = {item["Name"]: item["Value"] for item in response["Parameters"]}
if response.get("InvalidParameters") or set(values) != set(required):
    raise SystemExit("required SecureString runtime parameter is missing")
with open(sys.argv[2], "w", encoding="utf-8") as target:
    for parameter_name, environment_name in required.items():
        value = values[parameter_name]
        if "\n" in value or "\r" in value or "\x00" in value:
            raise SystemExit("runtime parameter contains an unsupported control character")
        target.write(f'{environment_name}="{value.replace(chr(92), chr(92) * 2).replace(chr(34), chr(92) + chr(34)}"\n')
PY

release_dir="$RELEASE_ROOT/$release_id"
[[ ! -e "$release_dir" ]] || fail "release ID already exists"
install -d -o root -g threadia -m 0750 "$RELEASE_ROOT"
install -d -o root -g threadia -m 0750 "$release_dir"
install -o root -g threadia -m 0640 "$stage/app.jar" "$release_dir/app.jar"
install -o root -g root -m 0644 "$stage/manifest.json" "$release_dir/manifest.json"
install -o root -g root -m 0644 "$stage/app.jar.sha256" "$release_dir/app.jar.sha256"
cp -a "$stage/runtime" "$release_dir/runtime"
chown -R root:threadia "$release_dir/runtime"
install -d -o root -g root -m 0750 /etc/threadia
install -o root -g threadia -m 0640 "$new_env" "$RUNTIME_ENV"

previous_target=""
if [[ -L "$ACTIVE_LINK" ]]; then
  previous_target="$(readlink -f "$ACTIVE_LINK")"
fi
ln -sfn "$release_dir" "$ACTIVE_LINK.new"
mv -Tf "$ACTIVE_LINK.new" "$ACTIVE_LINK"

rollback() {
  if [[ -n "$previous_target" && -d "$previous_target" ]]; then
    ln -sfn "$previous_target" "$ACTIVE_LINK.rollback"
    mv -Tf "$ACTIVE_LINK.rollback" "$ACTIVE_LINK"
    systemctl restart "$SERVICE_NAME" || true
  else
    systemctl stop "$SERVICE_NAME" || true
  fi
}

if ! systemctl restart "$SERVICE_NAME"; then
  rollback
  fail "systemd restart failed"
fi
if ! curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8080/actuator/health >/dev/null; then
  rollback
  fail "local health check failed; prior release restored when available"
fi

printf '%s\n' "release activated: $release_id"
