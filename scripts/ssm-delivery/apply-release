#!/usr/bin/env bash
set -euo pipefail

readonly RELEASE_ROOT=/opt/threadia/releases
readonly ACTIVE_LINK=/opt/threadia/current
readonly RUNTIME_ENV=/etc/threadia/runtime.env
readonly SERVICE_NAME=threadia-backend.service
readonly READINESS_TIMEOUT_SECONDS=120
readonly READINESS_INTERVAL_SECONDS=2
readonly HOST_LOCK=/run/threadia-release-maintenance.lock

fail() {
  printf '%s\n' "release failed: $*" >&2
  exit 1
}

[[ "$(id -u)" -eq 0 ]] || fail "must run as root"
[[ "$#" -eq 5 ]] || fail "expected bucket, artifact key, version ID, SHA-256, and release ID"
[[ -n "${AWS_REGION:-}" ]] || fail "AWS_REGION is required"
[[ "$AWS_REGION" =~ ^[a-z]{2}(-[a-z0-9]+)+-[0-9]+$ ]] || fail "invalid AWS_REGION"

bucket="$1"
artifact_key="$2"
version_id="$3"
expected_sha="$4"
release_id="$5"

[[ "$bucket" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ ]] || fail "invalid bucket"
[[ "$artifact_key" =~ ^releases/[0-9a-f]{40}/[0-9]+-[0-9]+/threadia-release-[0-9a-f]{40}-[0-9]+-[0-9]+\.tar\.gz$ ]] || fail "invalid artifact key"
[[ "$version_id" =~ ^[A-Za-z0-9._+=/-]{1,1000}[A-Za-z0-9._+=/-]{0,24}$ ]] || fail "invalid version ID"
[[ "$expected_sha" =~ ^[a-f0-9]{64}$ ]] || fail "invalid SHA-256"
[[ "$release_id" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ ]] || fail "invalid release ID"

for command in aws python3 sha256sum tar systemctl curl install uname flock; do
  command -v "$command" >/dev/null 2>&1 || fail "AMI prerequisite missing: $command"
done
[[ "$(uname -m)" == "x86_64" ]] || fail "bundled runtime supports Linux x86_64 only"

exec 9>"$HOST_LOCK"
flock -n 9 || fail "another release or helper maintenance operation is active"

umask 027
stage="$(mktemp -d /opt/threadia/.release-stage.XXXXXX)"
cleanup() { rm -rf "$stage"; }
trap cleanup EXIT

archive="$stage/release.tar.gz"
aws s3api get-object --region "$AWS_REGION" --bucket "$bucket" --key "$artifact_key" --version-id "$version_id" "$archive" >/dev/null
[[ "$(sha256sum "$archive" | cut -d ' ' -f1)" == "$expected_sha" ]] || fail "artifact archive checksum mismatch"
tar -xzf "$archive" -C "$stage"
[[ -f "$stage/app.jar" && -f "$stage/manifest.json" && -f "$stage/app.jar.sha256" && -x "$stage/runtime/bin/java" ]] || fail "release layout is incomplete"
"$stage/runtime/bin/java" -version >/dev/null 2>&1 || fail "bundled runtime is incompatible with this host"

python3 - "$stage/manifest.json" "$release_id" <<'PY'
import json
import sys

manifest_path, release_id = sys.argv[1:]
with open(manifest_path, encoding="utf-8") as source:
    manifest = json.load(source)
if manifest != {"releaseId": release_id}:
    raise SystemExit("manifest does not match immutable command identity")
PY

jar_sha="$(sha256sum "$stage/app.jar" | cut -d ' ' -f1)"
[[ "$(tr -d '[:space:]' < "$stage/app.jar.sha256")" == "$jar_sha" ]] || fail "JAR checksum mismatch"

new_env="$stage/runtime.env"
parameters_json="$stage/runtime-parameters.json"
aws ssm get-parameters --region "$AWS_REGION" --with-decryption --names \
  /threadia/restricted-nonprod/runtime/THREADIA_DB_URL \
  /threadia/restricted-nonprod/runtime/THREADIA_DB_USERNAME \
  /threadia/restricted-nonprod/runtime/THREADIA_DB_PASSWORD \
  /threadia/restricted-nonprod/runtime/THREADIA_JWT_SECRET \
  /threadia/restricted-nonprod/runtime/THREADIA_COOKIE_SECURE \
  /threadia/restricted-nonprod/runtime/THREADIA_CORS_ALLOWED_ORIGIN \
  /threadia/restricted-nonprod/runtime/THREADIA_AUDIT_CURSOR_HMAC_SECRET \
  /threadia/restricted-nonprod/runtime/THREADIA_PLATFORM_ADMIN_BOOTSTRAP_EMAIL \
  --output json > "$parameters_json"
python3 - "$parameters_json" "$new_env" <<'PY'
import json
import re
import sys


def has_unsupported_control_character(value):
    return any(ord(character) < 32 or ord(character) == 127 for character in value)

required = {
    "/threadia/restricted-nonprod/runtime/THREADIA_DB_URL": "THREADIA_DB_URL",
    "/threadia/restricted-nonprod/runtime/THREADIA_DB_USERNAME": "THREADIA_DB_USERNAME",
    "/threadia/restricted-nonprod/runtime/THREADIA_DB_PASSWORD": "THREADIA_DB_PASSWORD",
    "/threadia/restricted-nonprod/runtime/THREADIA_JWT_SECRET": "THREADIA_JWT_SECRET",
    "/threadia/restricted-nonprod/runtime/THREADIA_COOKIE_SECURE": "THREADIA_COOKIE_SECURE",
    "/threadia/restricted-nonprod/runtime/THREADIA_CORS_ALLOWED_ORIGIN": "THREADIA_CORS_ALLOWED_ORIGIN",
    "/threadia/restricted-nonprod/runtime/THREADIA_AUDIT_CURSOR_HMAC_SECRET": "THREADIA_AUDIT_CURSOR_HMAC_SECRET",
}
bootstrap_parameter = "/threadia/restricted-nonprod/runtime/THREADIA_PLATFORM_ADMIN_BOOTSTRAP_EMAIL"
with open(sys.argv[1], encoding="utf-8") as source:
    response = json.load(source)
parameter_items = response["Parameters"]
returned_names = [item["Name"] for item in parameter_items]
values = {item["Name"]: item["Value"] for item in parameter_items}
returned = set(values)
invalid = set(response.get("InvalidParameters", []))
expected = set(required) | {bootstrap_parameter}
if len(returned_names) != len(values) or returned - expected or invalid - expected:
    raise SystemExit("runtime parameter response does not match the exact requested names")
if set(required) != (returned & set(required)) or (invalid & set(required)):
    raise SystemExit("required SecureString runtime parameter is missing")
if bootstrap_parameter in returned and bootstrap_parameter in invalid:
    raise SystemExit("platform admin bootstrap parameter response is inconsistent")
if bootstrap_parameter not in returned and invalid != {bootstrap_parameter}:
    raise SystemExit("platform admin bootstrap parameter response is inconsistent")
for parameter_name, value in values.items():
    if has_unsupported_control_character(value):
        raise SystemExit("runtime parameter contains an unsupported control character: " + parameter_name)
audit_parameter = "/threadia/restricted-nonprod/runtime/THREADIA_AUDIT_CURSOR_HMAC_SECRET"
audit_secret = values[audit_parameter].strip()
if not audit_secret or len(audit_secret.encode("utf-8")) < 32:
    raise SystemExit("audit cursor runtime secret is blank or shorter than 32 UTF-8 bytes")
bootstrap_email = None
if bootstrap_parameter in returned:
    bootstrap_email = values[bootstrap_parameter].strip().lower()
    if not re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", bootstrap_email):
        raise SystemExit("platform admin bootstrap email is blank or malformed")
with open(sys.argv[2], "w", encoding="utf-8") as target:
    for parameter_name, environment_name in required.items():
        value = values[parameter_name]
        escaped_value = value.replace("\\", "\\\\").replace('"', '\\"')
        target.write(f'{environment_name}="{escaped_value}"\n')
    if bootstrap_email is not None:
        escaped_value = bootstrap_email.replace("\\", "\\\\").replace('"', '\\"')
        target.write(f'THREADIA_PLATFORM_ADMIN_BOOTSTRAP_EMAIL="{escaped_value}"\n')
PY

mail_parameters_json="$stage/mail-runtime-parameters.json"
aws ssm get-parameters --region "$AWS_REGION" --with-decryption --names \
  /threadia/restricted-nonprod/runtime/MAIL_HOST \
  /threadia/restricted-nonprod/runtime/MAIL_PORT \
  /threadia/restricted-nonprod/runtime/MAIL_USERNAME \
  /threadia/restricted-nonprod/runtime/MAIL_PASSWORD \
  /threadia/restricted-nonprod/runtime/NOTIFICATION_FROM_EMAIL \
  --output json > "$mail_parameters_json"
python3 - "$mail_parameters_json" "$new_env" <<'PY'
import json
import sys


def has_unsupported_control_character(value):
    return any(ord(character) < 32 or ord(character) == 127 for character in value)

optional = {
    "/threadia/restricted-nonprod/runtime/MAIL_HOST": "MAIL_HOST",
    "/threadia/restricted-nonprod/runtime/MAIL_PORT": "MAIL_PORT",
    "/threadia/restricted-nonprod/runtime/MAIL_USERNAME": "MAIL_USERNAME",
    "/threadia/restricted-nonprod/runtime/MAIL_PASSWORD": "MAIL_PASSWORD",
    "/threadia/restricted-nonprod/runtime/NOTIFICATION_FROM_EMAIL": "NOTIFICATION_FROM_EMAIL",
}
with open(sys.argv[1], encoding="utf-8") as source:
    response = json.load(source)
values = {item["Name"]: item["Value"] for item in response["Parameters"]}
returned = set(values) & set(optional)
invalid = set(response.get("InvalidParameters", [])) & set(optional)
if not returned and invalid == set(optional):
    raise SystemExit(0)
if returned != set(optional) or invalid:
    affected = sorted(invalid | (set(optional) - returned))
    raise SystemExit("optional runtime parameter group is incomplete or invalid: " + ", ".join(affected))
for parameter_name in optional:
    value = values[parameter_name]
    if value == "":
        raise SystemExit("optional runtime parameter is blank: " + parameter_name)
    if has_unsupported_control_character(value):
        raise SystemExit("optional runtime parameter contains an unsupported control character: " + parameter_name)
with open(sys.argv[2], "a", encoding="utf-8") as target:
    for parameter_name, environment_name in optional.items():
        value = values[parameter_name]
        escaped_value = value.replace(chr(92), chr(92) * 2).replace(chr(34), chr(92) + chr(34))
        target.write(f'{environment_name}="{escaped_value}"\n')
PY

release_dir="$RELEASE_ROOT/$release_id"
[[ ! -e "$release_dir" ]] || fail "release ID already exists"
install -d -o root -g threadia -m 0750 "$RELEASE_ROOT"
install -d -o root -g threadia -m 0750 "$release_dir"
install -o root -g threadia -m 0640 "$stage/app.jar" "$release_dir/app.jar"
install -o root -g root -m 0644 "$stage/manifest.json" "$release_dir/manifest.json"
install -o root -g root -m 0644 "$stage/app.jar.sha256" "$release_dir/app.jar.sha256"
cp -a "$stage/runtime" "$release_dir/runtime"
chown -R root:threadia "$release_dir/runtime"
install -d -o root -g root -m 0750 /etc/threadia

previous_target=""
if [[ -L "$ACTIVE_LINK" ]]; then
  previous_target="$(readlink -f "$ACTIVE_LINK")"
fi

previous_env="$stage/runtime.env.previous"
had_previous_env=false
if [[ -f "$RUNTIME_ENV" ]]; then
  cp -a "$RUNTIME_ENV" "$previous_env"
  had_previous_env=true
fi

rollback() {
  local rollback_failed=0

  rm -f "$RUNTIME_ENV.new" "$ACTIVE_LINK.new" "$ACTIVE_LINK.rollback" || rollback_failed=1
  if [[ "$had_previous_env" == true ]]; then
    install -o root -g threadia -m 0640 "$previous_env" "$RUNTIME_ENV" || rollback_failed=1
  else
    rm -f "$RUNTIME_ENV" || rollback_failed=1
  fi

  if [[ -n "$previous_target" && -d "$previous_target" ]]; then
    ln -sfn "$previous_target" "$ACTIVE_LINK.rollback" || rollback_failed=1
    mv -Tf "$ACTIVE_LINK.rollback" "$ACTIVE_LINK" || rollback_failed=1
    systemctl restart "$SERVICE_NAME" || rollback_failed=1
  else
    rm -f "$ACTIVE_LINK" || rollback_failed=1
    systemctl stop "$SERVICE_NAME" || rollback_failed=1
  fi

  return "$rollback_failed"
}

if ! install -o root -g threadia -m 0640 "$new_env" "$RUNTIME_ENV.new" ||
  ! mv -Tf "$RUNTIME_ENV.new" "$RUNTIME_ENV" ||
  ! ln -sfn "$release_dir" "$ACTIVE_LINK.new" ||
  ! mv -Tf "$ACTIVE_LINK.new" "$ACTIVE_LINK"; then
  rollback || fail "release activation and rollback failed"
  fail "release activation failed; prior runtime state restored"
fi

if ! systemctl restart "$SERVICE_NAME"; then
  rollback || fail "systemd restart and rollback failed"
  fail "systemd restart failed"
fi

readiness_failure="local health check did not pass within ${READINESS_TIMEOUT_SECONDS} seconds"
readiness_deadline=$((SECONDS + READINESS_TIMEOUT_SECONDS))
while (( SECONDS < readiness_deadline )); do
  if ! systemctl is-active --quiet "$SERVICE_NAME"; then
    readiness_failure="systemd service became inactive during readiness polling"
    break
  fi
  if curl --fail --silent --show-error --connect-timeout 1 --max-time 2 http://127.0.0.1:8080/actuator/health >/dev/null; then
    printf '%s\n' "release activated: $release_id"
    exit 0
  fi
  sleep "$READINESS_INTERVAL_SECONDS"
done

if ! rollback; then
  fail "$readiness_failure; rollback also failed"
fi
fail "$readiness_failure; prior runtime state restored"
