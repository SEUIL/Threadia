[Unit]
Description=Threadia backend service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threadia
Group=threadia
WorkingDirectory=/opt/threadia/current
EnvironmentFile=/etc/threadia/runtime.env
Environment=MANAGEMENT_HEALTH_MAIL_ENABLED=false
ExecStart=/opt/threadia/current/runtime/bin/java -jar /opt/threadia/current/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/threadia

[Install]
WantedBy=multi-user.target
