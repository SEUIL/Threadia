# Root-only public Compose attachment runtime configuration.
# Copy approved values outside the repository to /etc/threadia-compose/runtime.env.
# Do not set THREADIA_STORAGE_S3_ENDPOINT, THREADIA_STORAGE_S3_ACCESS_KEY, or THREADIA_STORAGE_S3_SECRET_KEY in AWS.
THREADIA_STORAGE_S3_REGION=ap-northeast-2
THREADIA_STORAGE_S3_BUCKET=replace-with-approved-dedicated-attachment-bucket
THREADIA_STORAGE_S3_PATH_STYLE=false
THREADIA_STORAGE_S3_PRESIGN_TTL=PT10M
THREADIA_STORAGE_ORPHAN_CLEANUP_ENABLED=true
THREADIA_STORAGE_ORPHAN_CLEANUP_DELAY=PT1H
THREADIA_STORAGE_UPLOAD_CLEANUP_DELAY=PT24H
