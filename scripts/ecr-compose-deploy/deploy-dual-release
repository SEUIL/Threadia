#!/usr/bin/env bash
set -euo pipefail
readonly ROOT=/opt/threadia-compose PROJECT=threadia-compose-dual COMPOSE=/opt/threadia-compose/compose.dual-image.production.yml RUNTIME=/etc/threadia-compose/runtime.env STATE=/var/lib/threadia-compose-dual/current-release.env LEGACY_STATE=/var/lib/threadia-compose/current-image LOCK=/run/lock/threadia-compose-dual.lock
fail(){ printf '%s\n' "public dual release failed: $*" >&2; exit 1; }
valid(){ [[ "$1" =~ ^[0-9]{12}\.dkr\.ecr\.[a-z]{2}(-[a-z0-9]+)+-[0-9]+\.amazonaws\.com/[a-z0-9]+([._/-][a-z0-9]+)*@sha256:[a-f0-9]{64}$ ]]; }
[[ "$(id -u)" == 0 && $# == 3 ]] || fail "expected ReleaseId FrontendImageRef BackendImageRef as root"
release_id=$1; frontend=$2; backend=$3
[[ "$release_id" =~ ^[0-9a-f]{40}-[1-9][0-9]*-[1-9][0-9]*$ ]] && valid "$frontend" && valid "$backend" || fail "invalid release identity"
for x in "$0" "$COMPOSE" "$RUNTIME"; do [[ -f "$x" ]] || fail "missing $x"; [[ "$(stat -c '%U:%G:%a' "$x")" =~ ^root:root: ]]; done
[[ "$(stat -c '%a' "$RUNTIME")" == 600 && "$(uname -m)" == x86_64 ]] || fail "invalid host runtime contract"
[[ -z "$(docker ps --filter label=com.docker.compose.project=threadia-compose --filter label=com.docker.compose.service=app --quiet)" && ! -f "$LEGACY_STATE" ]] || fail "legacy public backend-only Compose must be manually migrated first"
install -d -o root -g root -m 0700 "${STATE%/*}" /run/lock
exec 9>"$LOCK"; flock -n 9 || fail "another dual release is active"
compose(){ THREADIA_FRONTEND_IMAGE="$frontend" THREADIA_BACKEND_IMAGE="$backend" THREADIA_RUNTIME_ENV_FILE="$RUNTIME" docker compose --project-name "$PROJECT" --project-directory "$ROOT" --env-file "$RUNTIME" --file "$COMPOSE" "$@"; }
DOCKER_CONFIG="$(mktemp -d)"; export DOCKER_CONFIG; trap 'rm -rf "$DOCKER_CONFIG"' EXIT
for image in "$frontend" "$backend"; do registry=${image%%/*}; region=${registry#*.dkr.ecr.}; region=${region%.amazonaws.com}; aws ecr get-login-password --region "$region" | docker login --username AWS --password-stdin "$registry" >/dev/null; done
previous=""; [[ -f "$STATE" ]] && previous="$(<"$STATE")"
if ! compose pull frontend backend || ! compose up -d --no-deps --force-recreate frontend backend; then fail "candidate could not start"; fi
deadline=$((SECONDS+180)); healthy=false
while ((SECONDS<deadline)); do curl --fail --silent --max-time 2 http://127.0.0.1:3000/ >/dev/null && curl --fail --silent --max-time 2 http://127.0.0.1:8080/actuator/health >/dev/null && { healthy=true; break; }; sleep 3; done
if [[ "$healthy" != true ]]; then compose rm -f -s frontend backend >/dev/null 2>&1 || true; [[ -z "$previous" ]] || fail "candidate failed; restore prior dual manifest manually"; fail "candidate failed"; fi
tmp="$(mktemp "${STATE%/*}/.release.XXXXXX")"; printf 'THREADIA_RELEASE_ID=%s\nTHREADIA_FRONTEND_IMAGE=%s\nTHREADIA_BACKEND_IMAGE=%s\n' "$release_id" "$frontend" "$backend" > "$tmp"; chmod 600 "$tmp"; mv "$tmp" "$STATE"
