# Immutable public dual-image release manifest. Store each approved release on
# the host as a root-owned, non-group/world-writable file.
THREADIA_RELEASE_ID=0123456789abcdef0123456789abcdef01234567-123-1
THREADIA_FRONTEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/threadia-frontend@sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
THREADIA_BACKEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/threadia-backend@sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
