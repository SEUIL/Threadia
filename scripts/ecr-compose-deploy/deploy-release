#!/usr/bin/env bash
set -euo pipefail

readonly COMPOSE_ROOT=/opt/threadia-compose
readonly COMPOSE_PROJECT=threadia-compose
readonly COMPOSE_FILE="$COMPOSE_ROOT/compose.dual-image.production.yml"
readonly LEGACY_COMPOSE_FILE="$COMPOSE_ROOT/compose.production.yml"
readonly RUNTIME_ENV=/etc/threadia-compose/runtime.env
readonly STATE_ROOT=/var/lib/threadia-compose
readonly CURRENT_RELEASE_FILE="$STATE_ROOT/current-release.env"
readonly LEGACY_CURRENT_IMAGE_FILE="$STATE_ROOT/current-image"
readonly DEPLOY_LOCK_FILE=/run/lock/threadia-compose-deploy.lock
readonly FRONTEND_VALIDATION_CONTAINER=threadia-compose-frontend-validation
readonly HEALTH_TIMEOUT_SECONDS=180
readonly HEALTH_INTERVAL_SECONDS=3

fail() {
  printf '%s\n' "dual-image deployment failed: $*" >&2
  exit 1
}

validate_image_ref() {
  local image_ref="$1"

  [[ "$image_ref" =~ ^[0-9]{12}\.dkr\.ecr\.([a-z]{2}(-[a-z0-9]+)+-[0-9]+)\.amazonaws\.com/[a-z0-9]+([._/-][a-z0-9]+)*@sha256:[a-f0-9]{64}$ ]]
}

require_root_owned_non_writable() {
  local path="$1"
  local owner group mode

  owner="$(stat -c '%U' "$path")"
  group="$(stat -c '%G' "$path")"
  mode="$(stat -c '%a' "$path")"
  [[ "$owner" == root && "$group" == root ]] || fail "$path must be owned by root:root"
  (( (8#$mode & 0022) == 0 )) || fail "$path must not be writable by group or others"
}

read_release_manifest() {
  local manifest="$1"
  local line key value

  release_id=""
  frontend_image=""
  backend_image=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || fail "invalid release manifest line"
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      THREADIA_RELEASE_ID) [[ -z "$release_id" ]] || fail "duplicate THREADIA_RELEASE_ID"; release_id="$value" ;;
      THREADIA_FRONTEND_IMAGE) [[ -z "$frontend_image" ]] || fail "duplicate THREADIA_FRONTEND_IMAGE"; frontend_image="$value" ;;
      THREADIA_BACKEND_IMAGE) [[ -z "$backend_image" ]] || fail "duplicate THREADIA_BACKEND_IMAGE"; backend_image="$value" ;;
      *) fail "unsupported release manifest key: $key" ;;
    esac
  done < "$manifest"

  [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || fail "THREADIA_RELEASE_ID must be a safe immutable release identifier"
  validate_image_ref "$frontend_image" || fail "THREADIA_FRONTEND_IMAGE must be a full ECR repository@sha256 reference"
  validate_image_ref "$backend_image" || fail "THREADIA_BACKEND_IMAGE must be a full ECR repository@sha256 reference"
}

write_release_manifest() {
  local destination="$1"
  local temporary_file

  temporary_file="$(mktemp "$STATE_ROOT/.release.XXXXXX")"
  {
    printf 'THREADIA_RELEASE_ID=%s\n' "$release_id"
    printf 'THREADIA_FRONTEND_IMAGE=%s\n' "$frontend_image"
    printf 'THREADIA_BACKEND_IMAGE=%s\n' "$backend_image"
  } > "$temporary_file"
  chmod 0600 "$temporary_file"
  mv -f "$temporary_file" "$destination"
}

compose_for_release() {
  local manifest="$1"
  shift

  THREADIA_RUNTIME_ENV_FILE="$RUNTIME_ENV" docker compose \
    --project-name "$COMPOSE_PROJECT" \
    --project-directory "$COMPOSE_ROOT" \
    --env-file "$RUNTIME_ENV" \
    --env-file "$manifest" \
    --file "$COMPOSE_FILE" \
    "$@"
}

compose_for_legacy_image() {
  local image_ref="$1"
  shift

  THREADIA_IMAGE="$image_ref" THREADIA_RUNTIME_ENV_FILE="$RUNTIME_ENV" docker compose \
    --project-name "$COMPOSE_PROJECT" \
    --project-directory "$COMPOSE_ROOT" \
    --env-file "$RUNTIME_ENV" \
    --file "$LEGACY_COMPOSE_FILE" \
    "$@"
}

read_legacy_image() {
  local image_ref

  [[ -f "$LEGACY_CURRENT_IMAGE_FILE" ]] || return 1
  image_ref="$(<"$LEGACY_CURRENT_IMAGE_FILE")"
  validate_image_ref "$image_ref" || fail "legacy current-image contains an invalid image reference"
  printf '%s\n' "$image_ref"
}

verify_legacy_release() {
  local image_ref="$1"
  local running_services legacy_container running_image

  running_services="$(compose_for_legacy_image "$image_ref" ps --status running --services)"
  [[ "$running_services" == "app" ]] || return 1
  legacy_container="$(compose_for_legacy_image "$image_ref" ps --quiet app)"
  [[ -n "$legacy_container" ]] || return 1
  running_image="$(docker inspect --format '{{.Config.Image}}' "$legacy_container")"
  [[ "$running_image" == "$image_ref" ]]
}

pull_release_images() {
  local manifest="$1"

  compose_for_release "$manifest" pull frontend backend
  docker image inspect "$frontend_image" "$backend_image" >/dev/null
}

validate_frontend_candidate() {
  local validation_container_id published_address published_port deadline

  docker rm --force "$FRONTEND_VALIDATION_CONTAINER" >/dev/null 2>&1 || true
  if ! validation_container_id="$(docker run --detach --name "$FRONTEND_VALIDATION_CONTAINER" --publish 127.0.0.1::3000 "$frontend_image")"; then
    docker rm --force "$FRONTEND_VALIDATION_CONTAINER" >/dev/null 2>&1 || true
    return 1
  fi

  deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS))
  while (( SECONDS < deadline )); do
    published_address="$(docker port "$validation_container_id" 3000/tcp 2>/dev/null || true)"
    if [[ "$published_address" =~ ^127\.0\.0\.1:([1-9][0-9]*)$ ]]; then
      published_port="${BASH_REMATCH[1]}"
      if curl --fail --silent --show-error --connect-timeout 1 --max-time 2 "http://127.0.0.1:$published_port/" >/dev/null; then
        docker rm --force "$validation_container_id" >/dev/null
        return 0
      fi
    fi
    sleep "$HEALTH_INTERVAL_SECONDS"
  done

  docker rm --force "$validation_container_id" >/dev/null 2>&1 || true
  return 1
}

wait_for_health() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS))

  while (( SECONDS < deadline )); do
    if curl --fail --silent --show-error --connect-timeout 1 --max-time 2 http://127.0.0.1:3000/ >/dev/null && \
      curl --fail --silent --show-error --connect-timeout 1 --max-time 2 http://127.0.0.1:8080/actuator/health >/dev/null; then
      return 0
    fi
    sleep "$HEALTH_INTERVAL_SECONDS"
  done

  return 1
}

start_release() {
  local manifest="$1"

  compose_for_release "$manifest" up --detach --no-deps --force-recreate frontend backend
}

verify_running_release() {
  local manifest="$1"
  local running_services frontend_container backend_container running_frontend_image running_backend_image

  running_services="$(compose_for_release "$manifest" ps --status running --services | sort)"
  [[ "$running_services" == $'backend\nfrontend' ]] || return 1
  frontend_container="$(compose_for_release "$manifest" ps --quiet frontend)"
  backend_container="$(compose_for_release "$manifest" ps --quiet backend)"
  [[ -n "$frontend_container" && -n "$backend_container" ]] || return 1
  running_frontend_image="$(docker inspect --format '{{.Config.Image}}' "$frontend_container")"
  running_backend_image="$(docker inspect --format '{{.Config.Image}}' "$backend_container")"
  [[ "$running_frontend_image" == "$frontend_image" && "$running_backend_image" == "$backend_image" ]]
}

rollback() {
  local previous_manifest="$1"
  local candidate_manifest="$2"

  if [[ -f "$previous_manifest" ]]; then
    read_release_manifest "$previous_manifest"
    start_release "$previous_manifest" && wait_for_health && verify_running_release "$previous_manifest"
    return
  fi

  compose_for_release "$candidate_manifest" rm --force --stop frontend backend >/dev/null 2>&1 || true
}

rollback_legacy_release() {
  local legacy_image="$1"
  local candidate_manifest="$2"

  compose_for_release "$candidate_manifest" rm --force --stop frontend backend >/dev/null 2>&1 || true
  compose_for_legacy_image "$legacy_image" up --detach --no-deps --force-recreate app
  curl --fail --silent --show-error --connect-timeout 1 --max-time 2 \
    http://127.0.0.1:8080/actuator/health >/dev/null
}

[[ "$(id -u)" -eq 0 ]] || fail "must run as root"
[[ "$#" -eq 1 ]] || fail "expected exactly one root-owned immutable release manifest path"

candidate_manifest="$1"
[[ -f "$candidate_manifest" ]] || fail "release manifest is missing"
for command in aws curl docker flock install mktemp mv chmod rm stat sort uname; do
  command -v "$command" >/dev/null 2>&1 || fail "missing host prerequisite: $command"
done

for path in "$0" "$COMPOSE_FILE" "$RUNTIME_ENV" "$candidate_manifest"; do
  [[ -f "$path" ]] || fail "required file is missing: $path"
  require_root_owned_non_writable "$path"
done
[[ "$(stat -c '%a' "$RUNTIME_ENV")" == "600" ]] || fail "runtime environment file must have mode 0600"
[[ "$(uname -m)" == "x86_64" ]] || fail "production Compose runtime requires an x86_64 host"
read_release_manifest "$candidate_manifest"

install -d -o root -g root -m 0755 /run/lock
install -d -o root -g root -m 0700 "$STATE_ROOT"
exec 9>"$DEPLOY_LOCK_FILE"
flock -n 9 || fail "another compose deployment is already active"

previous_release_id="$release_id"
previous_frontend_image="$frontend_image"
previous_backend_image="$backend_image"
migrating_from_legacy=false
legacy_image=""
if [[ -f "$CURRENT_RELEASE_FILE" ]]; then
  read_release_manifest "$CURRENT_RELEASE_FILE"
  verify_running_release "$CURRENT_RELEASE_FILE" || fail "running Compose services do not match current release state; reconcile manually"
else
  [[ ! -f "$LEGACY_CURRENT_IMAGE_FILE" ]] || fail "legacy backend-only current-image state is present; complete the documented one-time migration before dual-image deployment"
  legacy_running_services="$(docker ps --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" --filter "label=com.docker.compose.service=app" --format '{{.Label "com.docker.compose.service"}}' | sort)"
  [[ -z "$legacy_running_services" ]] || fail "legacy backend-only Compose app is running; complete the documented one-time migration before dual-image deployment"
  running_services="$(compose_for_release "$candidate_manifest" ps --status running --services)"
  [[ -z "$running_services" ]] || fail "Compose services are running without current release state; reconcile manually"
fi

candidate_release_id="$previous_release_id"
candidate_frontend_image="$previous_frontend_image"
candidate_backend_image="$previous_backend_image"
read_release_manifest "$candidate_manifest"

DOCKER_CONFIG="$(mktemp -d /run/threadia-compose-docker.XXXXXX)"
export DOCKER_CONFIG
trap 'rm -rf "$DOCKER_CONFIG"' EXIT

logged_in_registries=()
for image_ref in "$frontend_image" "$backend_image"; do
  registry="${image_ref%%/*}"
  aws_region="${registry#*.dkr.ecr.}"
  aws_region="${aws_region%.amazonaws.com}"
  if [[ " ${logged_in_registries[*]} " != *" $registry "* ]]; then
    aws ecr get-login-password --region "$aws_region" | docker login --username AWS --password-stdin "$registry" >/dev/null
    logged_in_registries+=("$registry")
  fi
done

if ! pull_release_images "$candidate_manifest"; then
  fail "candidate images could not be pulled and inspected before changing running services"
fi
if ! validate_frontend_candidate; then
  fail "candidate frontend did not become healthy before changing running services"
fi

if ! start_release "$candidate_manifest" || ! wait_for_health || ! verify_running_release "$candidate_manifest"; then
  if rollback "$CURRENT_RELEASE_FILE" "$candidate_manifest"; then
    fail "candidate release did not become healthy; prior release restored"
  fi
  fail "candidate release did not become healthy and rollback failed"
fi

write_release_manifest "$CURRENT_RELEASE_FILE"
printf '%s\n' "dual-image release activated: $release_id"
