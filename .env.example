# Threadia root/backend/local compose environment template.
# Copy to .env for local use only. Do not commit real .env files.
# REPLACE_ME values are placeholders; replace locally or in approved secret stores.

# Local MySQL compose / backend datasource
SPRING_PROFILES_ACTIVE=local
THREADIA_DB_NAME=threadia_test
THREADIA_DB_URL=jdbc:mysql://localhost:3307/threadia_test
THREADIA_DB_USERNAME=threadia
THREADIA_DB_PASSWORD=REPLACE_ME_LOCAL_DB_PASSWORD
THREADIA_DB_ROOT_PASSWORD=REPLACE_ME_LOCAL_ROOT_PASSWORD
THREADIA_DB_SCHEMA_VALIDATION=false

# Backend auth/runtime
THREADIA_JWT_SECRET=REPLACE_ME_32_BYTES_MINIMUM_LOCAL_JWT_SECRET
THREADIA_PROJECT_CHAT_CURSOR_HMAC_SECRET=REPLACE_ME_32_BYTES_MINIMUM_LOCAL_PROJECT_CHAT_CURSOR_SECRET
THREADIA_NOTIFICATION_CURSOR_HMAC_SECRET=REPLACE_ME_32_BYTES_MINIMUM_LOCAL_NOTIFICATION_CURSOR_SECRET
THREADIA_AUDIT_CURSOR_HMAC_SECRET=REPLACE_ME_32_BYTES_MINIMUM_LOCAL_AUDIT_CURSOR_SECRET
THREADIA_COOKIE_SECURE=false
THREADIA_REFRESH_TOKEN_EXPIRATION_DAYS=14
THREADIA_CORS_ALLOWED_ORIGIN=http://localhost:3000
THREADIA_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/hub
THREADIA_OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login?oauth=failed

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI={baseUrl}/api/v1/auth/oauth2/callback/{registrationId}

# Mail / password reset
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_FROM_EMAIL=
THREADIA_PASSWORD_RESET_URL_PREFIX=http://localhost:3000/reset-password?token=
THREADIA_PASSWORD_RESET_EXPIRATION_MINUTES=30

# Platform administration bootstrap. Must match an existing ACTIVE user when platform_admins is empty.
THREADIA_PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# Private user-content storage for local MinIO only.
THREADIA_STORAGE_S3_REGION=ap-northeast-2
THREADIA_STORAGE_S3_BUCKET=threadia-private
THREADIA_STORAGE_S3_ENDPOINT=http://localhost:9000
THREADIA_STORAGE_S3_ACCESS_KEY=${THREADIA_MINIO_ROOT_USER}
THREADIA_STORAGE_S3_SECRET_KEY=${THREADIA_MINIO_ROOT_PASSWORD}
THREADIA_STORAGE_S3_PATH_STYLE=true
THREADIA_STORAGE_S3_PRESIGN_TTL=PT10M
THREADIA_STORAGE_ORPHAN_CLEANUP_ENABLED=true
THREADIA_MINIO_ROOT_USER=REPLACE_ME_LOCAL_MINIO_ACCESS_KEY
THREADIA_MINIO_ROOT_PASSWORD=REPLACE_ME_LOCAL_MINIO_SECRET_KEY
