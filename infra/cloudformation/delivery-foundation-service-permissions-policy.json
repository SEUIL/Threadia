{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRegionalDeliveryActionsOutsideSeoul",
      "Effect": "Deny",
      "Action": [
        "ec2:*",
        "s3:*",
        "ssm:*",
        "codedeploy:*",
        "secretsmanager:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "DenySecretReadAndUnrelatedServices",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "route53:*",
        "route53domains:*",
        "acm:*",
        "acm-pca:*",
        "amplify:*",
        "codebuild:*",
        "codepipeline:*",
        "codeconnections:*",
        "codestar-connections:*",
        "ecs:*",
        "ecr:*",
        "lambda:*",
        "apigateway:*",
        "elasticloadbalancing:*",
        "ssm:SendCommand",
        "ssm:StartSession",
        "ssm:ResumeSession"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIamCredentialPolicyAndTrustEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateUser",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:CreateServiceLinkedRole",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOidcMutation",
      "Effect": "Deny",
      "Action": [
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyNonDeliveryTrustUpdate",
      "Effect": "Deny",
      "Action": "iam:UpdateAssumeRolePolicy",
      "NotResource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-GitHubDeployRole-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-CodeDeployServiceRole-*"
      ]
    },
    {
      "Sid": "AllowDeliveryOidcProviderLifecycle",
      "Effect": "Allow",
      "Action": "iam:CreateOpenIDConnectProvider",
      "Resource": "*"
    },
    {
      "Sid": "AllowDeliveryOidcProviderReadTagAndDelete",
      "Effect": "Allow",
      "Action": [
        "iam:GetOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:UntagOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "AllowCreateDeliveryRolesWithRequiredTags",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-GitHubDeployRole-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-CodeDeployServiceRole-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "Threadia",
          "aws:RequestTag/Environment": "restricted-nonprod",
          "aws:RequestTag/ManagedBy": "CloudFormation"
        }
      }
    },
    {
      "Sid": "AllowDeliveryRoleReadTagAndDelete",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-GitHubDeployRole-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-CodeDeployServiceRole-*"
      ]
    },
    {
      "Sid": "AllowGitHubDeployRoleInlinePolicyLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-GitHubDeployRole-*"
    },
    {
      "Sid": "AllowCodeDeployManagedPolicyAttachmentOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-CodeDeployServiceRole-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSCodeDeployRole"
        }
      }
    },
    {
      "Sid": "AllowScopedExistingEc2ArtifactInlinePolicyOnly",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-restricted-foundation-Ec2Role-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-restricted-compute-Ec2Role-*"
      ]
    },
    {
      "Sid": "AllowPassCodeDeployServiceRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-delivery-foundation-CodeDeployServiceRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "codedeploy.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowCreateAndReadDeliveryArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowDeliveryArtifactBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::threadia-delivery-foundation-artifactbucket-*"
    },
    {
      "Sid": "AllowCodeDeployApplicationAndGroupLifecycle",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateApplication",
        "codedeploy:CreateDeploymentGroup",
        "codedeploy:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCodeDeployManage",
      "Effect": "Allow",
      "Action": [
        "codedeploy:GetApplication",
        "codedeploy:ListTagsForResource",
        "codedeploy:DeleteApplication",
        "codedeploy:GetDeploymentGroup",
        "codedeploy:UpdateDeploymentGroup",
        "codedeploy:DeleteDeploymentGroup",
        "codedeploy:UntagResource"
      ],
      "Resource": [
        "arn:aws:codedeploy:ap-northeast-2:<AWS_ACCOUNT_ID>:application:threadia-delivery-foundation-CodeDeployApplication-*",
        "arn:aws:codedeploy:ap-northeast-2:<AWS_ACCOUNT_ID>:deploymentgroup:threadia-delivery-foundation-CodeDeployApplication-*/threadia-delivery-foundation-CodeDeployDeploymentGroup-*"
      ]
    },
    {
      "Sid": "AllowApprovedCodeDeployAgentAssociationOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateAssociation"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2::document/AWS-ConfigureAWSPackage"
    },
    {
      "Sid": "AllowDeliveryAssociationReadAndDeleteOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeAssociation",
        "ssm:DeleteAssociation"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:association/*"
    },
    {
      "Sid": "AllowCodeDeployAgentAssociationUpdateOnly",
      "Effect": "Allow",
      "Action": "ssm:UpdateAssociation",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-ConfigureAWSPackage",
        "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:association/*"
      ]
    }
  ]
}
