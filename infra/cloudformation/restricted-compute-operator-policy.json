{"Version":"2012-10-17","Statement":[{"Sid":"AllowComputeChangeSetCreation","Effect":"Allow","Action":"cloudformation:CreateChangeSet","Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-compute/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-compute-*/*"],"Condition":{"StringEquals":{"cloudformation:RoleARN":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedComputeCloudFormationServiceRole","aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation"},"StringLike":{"cloudformation:ChangeSetName":"restricted-compute-*"},"Null":{"aws:RequestTag/Owner":"false"}}},{"Sid":"AllowComputeChangeSetLifecycle","Effect":"Allow","Action":["cloudformation:DescribeChangeSet","cloudformation:ExecuteChangeSet","cloudformation:DeleteChangeSet"],"Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-compute/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-compute-*/*"]},{"Sid":"AllowComputeStackReview","Effect":"Allow","Action":["cloudformation:DescribeStacks","cloudformation:DescribeStackEvents","cloudformation:DescribeStackResources","cloudformation:GetTemplate"],"Resource":"arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-compute/*"},{"Sid":"AllowPassExactComputeServiceRole","Effect":"Allow","Action":"iam:PassRole","Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedComputeCloudFormationServiceRole","Condition":{"StringEquals":{"iam:PassedToService":"cloudformation.amazonaws.com"}}}]}
