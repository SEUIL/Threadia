{"Version":"2012-10-17","Statement":[{"Sid":"AllowComputeReadOnly","Effect":"Allow","Action":["ec2:DescribeImages","ec2:DescribeInstances","ec2:DescribeNetworkInterfaces","ec2:DescribeSecurityGroups","ec2:DescribeSubnets","ec2:DescribeVolumes","iam:GetRole","iam:GetInstanceProfile","iam:ListAttachedRolePolicies","iam:ListInstanceProfilesForRole"],"Resource":"*"},{"Sid":"AllowTaggedEc2SecurityGroupEgress","Effect":"Allow","Action":["ec2:AuthorizeSecurityGroupEgress","ec2:RevokeSecurityGroupEgress"],"Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group/*","Condition":{"StringEquals":{"ec2:ResourceTag/Project":"Threadia","ec2:ResourceTag/Environment":"restricted-nonprod","ec2:ResourceTag/ManagedBy":"CloudFormation"},"Null":{"ec2:ResourceTag/Owner":"false"}}},{"Sid":"AllowApprovedAmiForRunInstances","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2::image/<APPROVED_AMI_ID>"},{"Sid":"AllowTaggedSubnetForRunInstances","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:subnet/*","Condition":{"StringEquals":{"ec2:ResourceTag/Project":"Threadia","ec2:ResourceTag/Environment":"restricted-nonprod","ec2:ResourceTag/ManagedBy":"CloudFormation"},"Null":{"ec2:ResourceTag/Owner":"false"}}},{"Sid":"AllowTaggedSecurityGroupForRunInstances","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group/*","Condition":{"StringEquals":{"ec2:ResourceTag/Project":"Threadia","ec2:ResourceTag/Environment":"restricted-nonprod","ec2:ResourceTag/ManagedBy":"CloudFormation"},"Null":{"ec2:ResourceTag/Owner":"false"}}},{"Sid":"AllowTaggedImdsV2Instance","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:instance/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation","ec2:InstanceType":["t3.micro","t3.small"],"ec2:MetadataHttpTokens":"required"},"Null":{"aws:RequestTag/Owner":"false"}}},{"Sid":"AllowEncryptedGp3VolumeForRunInstances","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:volume/*","Condition":{"StringEquals":{"ec2:VolumeType":"gp3"},"Bool":{"ec2:Encrypted":"true"}}},{"Sid":"AllowPrivateNetworkInterfaceForRunInstances","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:network-interface/*","Condition":{"Bool":{"ec2:AssociatePublicIpAddress":"false"}}},{"Sid":"AllowCreateTagsForComputeCreates","Effect":"Allow","Action":"ec2:CreateTags","Resource":["arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:instance/*","arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:volume/*","arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:network-interface/*"],"Condition":{"StringEquals":{"ec2:CreateAction":"RunInstances","aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation"},"Null":{"aws:RequestTag/Owner":"false"}}},{"Sid":"AllowScopedComputeRoleLifecycle","Effect":"Allow","Action":["iam:CreateRole","iam:DeleteRole","iam:TagRole","iam:AttachRolePolicy","iam:DetachRolePolicy","iam:PassRole"],"Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-restricted-compute-Ec2Role-*","Condition":{"ArnEqualsIfExists":{"iam:PolicyARN":"arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"},"StringEqualsIfExists":{"iam:PassedToService":"ec2.amazonaws.com"}}},{"Sid":"AllowScopedInstanceProfileLifecycle","Effect":"Allow","Action":["iam:CreateInstanceProfile","iam:DeleteInstanceProfile","iam:AddRoleToInstanceProfile","iam:RemoveRoleFromInstanceProfile"],"Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/threadia-restricted-compute-Ec2InstanceProfile-*"},{"Sid":"AllowTerminateTaggedComputeInstance","Effect":"Allow","Action":"ec2:TerminateInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:instance/*","Condition":{"StringEquals":{"ec2:ResourceTag/Project":"Threadia","ec2:ResourceTag/Environment":"restricted-nonprod","ec2:ResourceTag/ManagedBy":"CloudFormation"},"Null":{"ec2:ResourceTag/Owner":"false"}}}]}
