{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "route53:*",
        "route53domains:*",
        "acm:*",
        "acm-pca:*",
        "amplify:*",
        "codebuild:*",
        "codepipeline:*",
        "codedeploy:*",
        "codeconnections:*",
        "codestar-connections:*",
        "ecs:*",
        "ecr:*",
        "lambda:*",
        "apigateway:*",
        "elasticloadbalancing:*",
        "iam:*OpenIDConnectProvider*",
        "ssm:SendCommand",
        "ssm:StartSession",
        "ssm:ResumeSession",
        "ec2-instance-connect:SendSSHPublicKey",
        "ec2-instance-connect:OpenTunnel",
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateUser",
        "iam:CreateRole",
        "iam:CreateServiceLinkedRole",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "NotResource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedFoundationCloudFormationServiceRole"
    },
    {
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-foundation/*",
        "arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-foundation-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleARN": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedFoundationCloudFormationServiceRole",
          "aws:RequestTag/Project": "Threadia",
          "aws:RequestTag/Environment": "restricted-nonprod",
          "aws:RequestTag/ManagedBy": "CloudFormation"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "restricted-foundation-*"
        },
        "Null": {
          "aws:RequestTag/Owner": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-foundation/*",
        "arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-foundation-*/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-foundation/*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedFoundationCloudFormationServiceRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
