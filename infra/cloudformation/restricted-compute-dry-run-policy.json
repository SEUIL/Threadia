{"Version":"2012-10-17","Statement":[{"Sid":"AllowApprovedAmiDryRun","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2::image/<APPROVED_AMI_ID>"},{"Sid":"AllowExactSubnetDryRun","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:subnet/<APPROVED_SUBNET_ID>"},{"Sid":"AllowExactSecurityGroupDryRun","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:security-group/<APPROVED_SECURITY_GROUP_ID>"},{"Sid":"AllowImdsV2InstanceDryRun","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:instance/*","Condition":{"StringEquals":{"ec2:InstanceType":["t3.micro","t3.small"],"ec2:MetadataHttpTokens":"required"}}},{"Sid":"AllowEncryptedGp3VolumeDryRun","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:volume/*","Condition":{"StringEquals":{"ec2:VolumeType":"gp3"},"Bool":{"ec2:Encrypted":"true"}}},{"Sid":"AllowPrivateNetworkInterfaceDryRun","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:ap-northeast-2:<AWS_ACCOUNT_ID>:network-interface/*","Condition":{"Bool":{"ec2:AssociatePublicIpAddress":"false"}}}]}
