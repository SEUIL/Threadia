{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"DenyRegionalActionsOutsideSeoul","Effect":"Deny","Action":["ec2:*","s3:*","ssm:*"],"Resource":"*","Condition":{"StringNotEquals":{"aws:RequestedRegion":"ap-northeast-2"}}},
    {"Sid":"DenyCodeDeploySecretsAndInteractiveAccess","Effect":"Deny","Action":["codedeploy:*","secretsmanager:*","ssm:GetParametersByPath","ssm:StartSession","ssm:ResumeSession","ssm:SendCommand","route53:*","acm:*","amplify:*","codebuild:*","codepipeline:*","codeconnections:*","codestar-connections:*"],"Resource":"*"},
    {"Sid":"DenyIamCredentialAndPolicyEscalation","Effect":"Deny","Action":["iam:CreateAccessKey","iam:UpdateAccessKey","iam:CreateUser","iam:CreatePolicy","iam:CreatePolicyVersion","iam:SetDefaultPolicyVersion","iam:DeletePolicy","iam:DeletePolicyVersion","iam:AttachRolePolicy","iam:DetachRolePolicy","iam:PutRolePermissionsBoundary","iam:DeleteRolePermissionsBoundary"],"Resource":"*"},
    {"Sid":"AllowCreateGitHubOidcProvider","Effect":"Allow","Action":"iam:CreateOpenIDConnectProvider","Resource":"*"},
    {"Sid":"AllowManageExactGitHubOidcProvider","Effect":"Allow","Action":["iam:GetOpenIDConnectProvider","iam:TagOpenIDConnectProvider","iam:UntagOpenIDConnectProvider","iam:DeleteOpenIDConnectProvider"],"Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"},
    {"Sid":"AllowCreateSsmDeliveryRoleWithRequiredTags","Effect":"Allow","Action":"iam:CreateRole","Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-restricted-ssm-delivery-GitHubDeployRole-*","Condition":{"StringEquals":{"aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation"}}},
    {"Sid":"AllowManageSsmDeliveryRole","Effect":"Allow","Action":["iam:GetRole","iam:DeleteRole","iam:UpdateRole","iam:UpdateRoleDescription","iam:UpdateAssumeRolePolicy","iam:TagRole","iam:UntagRole","iam:ListRolePolicies","iam:PutRolePolicy","iam:GetRolePolicy","iam:DeleteRolePolicy"],"Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-restricted-ssm-delivery-GitHubDeployRole-*"},
    {"Sid":"AllowManageExactEc2DeliveryInlinePolicy","Effect":"Allow","Action":["iam:PutRolePolicy","iam:GetRolePolicy","iam:DeleteRolePolicy"],"Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/threadia-restricted-compute-Ec2Role-*"},
    {"Sid":"AllowCreateAndReadArtifactBucket","Effect":"Allow","Action":["s3:CreateBucket","s3:ListAllMyBuckets","s3:GetBucketLocation"],"Resource":"*"},
    {"Sid":"AllowManageExactArtifactBucket","Effect":"Allow","Action":["s3:DeleteBucket","s3:DeleteBucketPolicy","s3:GetBucketEncryption","s3:GetBucketLifecycleConfiguration","s3:GetBucketOwnershipControls","s3:GetBucketPolicy","s3:GetBucketPublicAccessBlock","s3:GetBucketTagging","s3:GetBucketVersioning","s3:PutBucketEncryption","s3:PutBucketLifecycleConfiguration","s3:PutBucketOwnershipControls","s3:PutBucketPolicy","s3:PutBucketPublicAccessBlock","s3:PutBucketTagging","s3:PutBucketVersioning","s3:GetEncryptionConfiguration","s3:PutEncryptionConfiguration","s3:GetLifecycleConfiguration","s3:PutLifecycleConfiguration"],"Resource":"arn:aws:s3:::threadia-restricted-<AWS_ACCOUNT_ID>-ap-northeast-2-artifacts"},
    {"Sid":"AllowManageFixedCommandDocument","Effect":"Allow","Action":["ssm:CreateDocument","ssm:DescribeDocument","ssm:GetDocument","ssm:UpdateDocument","ssm:DeleteDocument","ssm:AddTagsToResource","ssm:RemoveTagsFromResource"],"Resource":"arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:document/threadia-restricted-ssm-delivery-ReleaseCommandDocument-*"},
    {"Sid":"AllowManageFixedHelperMaintenanceCommandDocument","Effect":"Allow","Action":["ssm:CreateDocument","ssm:DescribeDocument","ssm:GetDocument","ssm:UpdateDocument","ssm:DeleteDocument","ssm:AddTagsToResource","ssm:RemoveTagsFromResource"],"Resource":"arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:document/threadia-restricted-ssm-delivery-HelperMaintenanceCommandDocument-*"}
  ]
}
