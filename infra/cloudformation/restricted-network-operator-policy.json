{"Version":"2012-10-17","Statement":[{"Sid":"AllowNetworkChangeSetCreation","Effect":"Allow","Action":"cloudformation:CreateChangeSet","Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-network/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-network-*/*"],"Condition":{"StringEquals":{"cloudformation:RoleARN":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedNetworkCloudFormationServiceRole","aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation"},"StringLike":{"cloudformation:ChangeSetName":"restricted-network-*"},"Null":{"aws:RequestTag/Owner":"false"}}},{"Sid":"AllowNetworkChangeSetLifecycle","Effect":"Allow","Action":["cloudformation:DescribeChangeSet","cloudformation:ExecuteChangeSet","cloudformation:DeleteChangeSet"],"Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-network/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-network-*/*"]},{"Sid":"AllowNetworkStackReview","Effect":"Allow","Action":["cloudformation:DescribeStacks","cloudformation:DescribeStackEvents","cloudformation:DescribeStackResources","cloudformation:GetTemplate"],"Resource":"arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-network/*"},{"Sid":"AllowPassExactNetworkServiceRole","Effect":"Allow","Action":"iam:PassRole","Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedNetworkCloudFormationServiceRole","Condition":{"StringEquals":{"iam:PassedToService":"cloudformation.amazonaws.com"}}}]}
