{"Version":"2012-10-17","Statement":[{"Sid":"AllowSsmDeliveryChangeSetCreation","Effect":"Allow","Action":"cloudformation:CreateChangeSet","Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-ssm-delivery/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-ssm-delivery-*/*"],"Condition":{"StringEquals":{"cloudformation:RoleARN":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedSsmDeliveryCloudFormationServiceRole","aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation"},"StringLike":{"cloudformation:ChangeSetName":"restricted-ssm-delivery-*"},"Null":{"aws:RequestTag/Owner":"false"}}},{"Sid":"AllowSsmDeliveryChangeSetLifecycle","Effect":"Allow","Action":["cloudformation:DescribeChangeSet","cloudformation:DeleteChangeSet"],"Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-ssm-delivery/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-ssm-delivery-*/*"]},{"Sid":"AllowSsmDeliveryStackReview","Effect":"Allow","Action":["cloudformation:DescribeStacks","cloudformation:DescribeStackEvents","cloudformation:DescribeStackResources","cloudformation:GetTemplate"],"Resource":"arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-ssm-delivery/*"},{"Sid":"AllowPassExactSsmDeliveryServiceRole","Effect":"Allow","Action":"iam:PassRole","Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedSsmDeliveryCloudFormationServiceRole","Condition":{"StringEquals":{"iam:PassedToService":"cloudformation.amazonaws.com"}}}]}