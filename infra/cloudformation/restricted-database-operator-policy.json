{"Version":"2012-10-17","Statement":[{"Sid":"AllowDatabaseChangeSetCreation","Effect":"Allow","Action":"cloudformation:CreateChangeSet","Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-database/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-database-*/*"],"Condition":{"StringEquals":{"cloudformation:RoleARN":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedDatabaseCloudFormationServiceRole","aws:RequestTag/Project":"Threadia","aws:RequestTag/Environment":"restricted-nonprod","aws:RequestTag/ManagedBy":"CloudFormation"},"StringLike":{"cloudformation:ChangeSetName":"restricted-database-*"},"Null":{"aws:RequestTag/Owner":"false"}}},{"Sid":"AllowDatabaseChangeSetLifecycle","Effect":"Allow","Action":["cloudformation:DescribeChangeSet","cloudformation:ExecuteChangeSet","cloudformation:DeleteChangeSet"],"Resource":["arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-database/*","arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:changeSet/restricted-database-*/*"]},{"Sid":"AllowDatabaseStackReview","Effect":"Allow","Action":["cloudformation:DescribeStacks","cloudformation:DescribeStackEvents","cloudformation:DescribeStackResources","cloudformation:GetTemplate"],"Resource":"arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-database/*"},{"Sid":"AllowDeleteExactDatabaseStack","Effect":"Allow","Action":"cloudformation:DeleteStack","Resource":"arn:aws:cloudformation:ap-northeast-2:<AWS_ACCOUNT_ID>:stack/threadia-restricted-database/*"},{"Sid":"AllowPassExactDatabaseServiceRole","Effect":"Allow","Action":"iam:PassRole","Resource":"arn:aws:iam::<AWS_ACCOUNT_ID>:role/ThreadiaRestrictedDatabaseCloudFormationServiceRole","Condition":{"StringEquals":{"iam:PassedToService":"cloudformation.amazonaws.com"}}}]}
